   "var ME=null;",
   "async function doLogin(){",
   "  const ph=(document.getElementById('lgPhone').value||'').trim();",
   "  if(!/^\\d{6,15}$/.test(ph))return toast('请输入正确的手机号');",
   "  let r;",
   "  try{ r=await api('/api/login',{phone:ph}); }",
   "  catch(e){ return toast('连不上服务器，请稍后再试'); }",
   "  if(!r.ok||!r.student)return toast(r.msg||'登录失败');",
   "  ME=r.student;ST.id=ME.id;",
   "  try{localStorage.setItem('yangqin_phone',ph)}catch(e){}",
   "  enterApp();toast('欢迎回来，'+ME.name+'！');",
   "}",
   "async function enterApp(){",
   "  const g=document.getElementById('loginGate'); if(g)g.style.display='none';",
   "  const a=document.getElementById('app'); if(a)a.style.display='';",
   "  const n=document.getElementById('navS'); if(n)n.style.display='';",
   "  const tg=document.getElementById('meTag');",
   "  if(tg&&ME)tg.innerHTML='<span class=\"tag\" style=\"background:var(--stu-soft);color:var(--stu)\">'+esc(ME.name)+'</span>'",
   "    +' <button class=\"btn xs\" onclick=\"logout()\">退出</button>';",
   "  await pull();render();",
   "}",
   "function logout(){ try{localStorage.removeItem('yangqin_phone')}catch(e){} location.reload(); }",
